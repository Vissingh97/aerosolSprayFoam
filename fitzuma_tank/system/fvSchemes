FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

    div(phi,U)      Gauss upwind;
    div(phid,p)     Gauss upwind;
    div(phi,K)      Gauss linear;
    div(phi,k)      Gauss upwind;
    div(phi,epsilon) Gauss upwind;
    div(U)          Gauss linear;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    div(phi,Yi_h)   Gauss upwind;
    div(meshPi,p)   Gauss upwind;
    div(phi,aerosolBin0)            Gauss upwind;
    div(phi,aerosolBin1)            Gauss upwind;
    div(phi,aerosolBin2)            Gauss upwind;
    div(phi,aerosolBin3)            Gauss upwind;
    div(phi,aerosolBin4)            Gauss upwind;
    div(phi,aerosolBin5)            Gauss upwind;
    div(phi,aerosolBin6)            Gauss upwind;
    div(phi,aerosolBin7)            Gauss upwind;
    div(phi,aerosolBin8)            Gauss upwind;
}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}


